{
  "manifest_version": 3,
  "name": "Slides Category Shuffler + Timers",
  "version": "0.1.0",
  "permissions": ["identity", "activeTab", "scripting"],
  "host_permissions": [
    "https://docs.google.com/presentation/*",
    "https://slides.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "975390013387-1g34llptbhsovmvdrdh8avbrj5l7d5mo.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/presentations"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "start_timer": {
      "suggested_key": {
        "default": "Alt+0",
        "mac": "Alt+0"
      },
      "description": "Start timer 1 and go to next slide"
    },
    "switch_timer": {
      "suggested_key": {
        "default": "Alt+1",
        "mac": "Alt+1"
      },
      "description": "Switch timer and go to next slide"
    },
    "deduct_time": {
      "suggested_key": {
        "default": "Alt+2",
        "mac": "Alt+2"
      },
      "description": "Deduct 3 seconds and go to next slide"
    }
  }
}